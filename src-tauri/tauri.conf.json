{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F95 Game Manager",
  "version": "0.2.0",
  "identifier": "xyz.f95api.gamemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "F95 Game Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0e1014",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: gmimg: http://gmimg.localhost gmmedia: http://gmmedia.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Game library, update tracker and launcher for F95zone games"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "f95gm"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
